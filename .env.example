APP_NAME=TaskFlow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (PostgreSQL recommended for production cloud hosts like Supabase/Neon/Railway)
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=taskflow
# DB_USERNAME=postgres
# DB_PASSWORD=your_password
# DB_SSLMODE=require

# Or full database connection URL (e.g. Neon, Supabase, Railway)
# DB_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array

# n8n Webhook & Telegram Integration
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/taskflow-task
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_id

VITE_APP_NAME="${APP_NAME}"
